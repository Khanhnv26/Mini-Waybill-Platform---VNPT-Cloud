{
  "name": "vnpt-waybill-frontend",
  "version": "3.2.0",
  "description": "VNPT Waybill Platform Frontend",
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test && npm run build:css",
    "start": "node server.js 3000",
    "build:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.prod.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.prod.css --watch",
    "build": "npm run build:css && node scripts/build-dist.cjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "vue": "^3.5.43"
  }
}
