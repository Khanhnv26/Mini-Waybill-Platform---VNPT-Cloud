{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WaybillPlatform",
  "version": "1.0.0",
  "identifier": "com.waybill.platform",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "windows": [
      {
        "title": "Waybill Platform - Nền Tảng Điều Phối Bưu Chính",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
