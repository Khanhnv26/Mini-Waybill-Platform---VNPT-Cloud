{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WaybillPlatform",
  "version": "3.2.1",
  "identifier": "com.waybill.platform",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Waybill Platform - Nền Tảng Điều Phối Bưu Chính",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxOUUzRkM2MjQ5MjlDMjQKUldRa25KSWt4aitlZ1hKVmZQT1c2enYwTWp4aGFDcHpuak02UDVVTHVab0plcjNSUlhXbTNhYTMK",
      "endpoints": [
        "https://github.com/Khanhnv26/Mini-Waybill-Platform---VNPT-Cloud/releases/latest/download/latest.json"
      ]
    }
  }
}
