
# 1. Email Service (notification-service)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password

# 2. Telegram Bot (notification-service)
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username

# 3. Security JWT (auth-service & api-gateway)
JWT_SECRET=your_super_secret_key_at_least_256_bits_long

# 4. Database Credentials
DB_USERNAME=sa
DB_PASSWORD=sa

# 5. AI Assistant (support-service) - Ollama OpenAI-compatible, chạy khi support-service trên host
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:3b
